{
  "name": "lockdown",
  "description": "Lockdown policy: explicit DROP rules for all protocols block all inbound and outbound traffic",
  "rules": [
    {
      "direction": "INGRESS",
      "protocol": "TCP",
      "action": "DROP"
    },
    {
      "direction": "INGRESS",
      "protocol": "UDP",
      "action": "DROP"
    },
    {
      "direction": "INGRESS",
      "protocol": "ICMP",
      "action": "DROP"
    },
    {
      "direction": "INGRESS",
      "protocol": "ICMPv6",
      "action": "DROP"
    },
    {
      "direction": "EGRESS",
      "protocol": "TCP",
      "action": "DROP"
    },
    {
      "direction": "EGRESS",
      "protocol": "UDP",
      "action": "DROP"
    },
    {
      "direction": "EGRESS",
      "protocol": "ICMP",
      "action": "DROP"
    },
    {
      "direction": "EGRESS",
      "protocol": "ICMPv6",
      "action": "DROP"
    }
  ]
}
