# Netcup SCP — OIDC Authentication (Device Code Flow)
#
# Setup (one-time):
#   1. Run "Initiate Device Authorization" → device_code auto-captured
#   2. Visit verification_uri in browser, enter user_code
#   3. Run "Poll for Token" → tokens captured + saved to gnome-keyring
#   4. Run "Get User Info" → user_id captured + saved to gnome-keyring
#
# Per-session workflow:
#   1. Run "Refresh Token" (request 3) → refresh_token injected from gnome-keyring
#      via provideVariables hook; fetches fresh access_token into $global + keyring
#   2. Run "Get User Info" (request 4) — pre-request script loads access_token from
#      $global (set by request 3); falls back to keyring if $global is empty
#   3. All other .http files use {{access_token}} from $global (set in same session)
#   4. When access_token expires mid-session, re-run "Refresh Token"
#
# Token storage:
#   - gnome-keyring: source of truth for refresh_token, user_id
#     (service=netcup-scp, username=default, shared with netcup_firewall.py)
#   - access_token: ephemeral; lives in $global only (NOT in provideVariables hook)
#   - provideVariables hook (httpyac.config.js): injects refresh_token, user_id only
#   - httpyac.config.js in workspace root delegates to infra/http/httpyac.config.js
#   - http-client.private.env.json: semi-static values only (server_id, etc.)

### 1 — Initiate Device Authorization
# Opens a device authorization session. Returns:
#   device_code     — auto-captured into $global for request 2
#   user_code       — enter at verification_uri in your browser
#   verification_uri — URL to visit for authorization
POST {{oidc_base}}/auth/device
Content-Type: application/x-www-form-urlencoded

client_id={{client_id}}&scope=offline_access%20openid

{{
  $global.device_code = response.parsedBody.device_code;
  console.info("device_code captured — visit:", response.parsedBody.verification_uri_complete || response.parsedBody.verification_uri);
  console.info("user_code:", response.parsedBody.user_code);
}}

### 2 — Poll for Token
# Poll every 5 seconds until authorization_pending stops.
# device_code is auto-populated from request 1 via $global.
# Success: tokens captured into $global and saved to gnome-keyring.
# Pending: {"error": "authorization_pending"} — keep polling.
POST {{oidc_base}}/token
Content-Type: application/x-www-form-urlencoded

client_id={{client_id}}&grant_type=urn:ietf:params:oauth:grant-type:device_code&device_code={{device_code}}

{{
  if (response.parsedBody.access_token) {
    $global.access_token = response.parsedBody.access_token;
    if (response.parsedBody.refresh_token) {
      $global.refresh_token = response.parsedBody.refresh_token;
    }
    console.info("Tokens captured into $global.");
    const config = require('./httpyac.config.js');
    config.saveToKeyring(response.parsedBody);
    console.info("Tokens saved to gnome-keyring (shared with netcup_firewall.py).");
  } else {
    console.warn("authorization_pending — poll again in 5s");
  }
}}

### 3 — Refresh Token (run once per session)
# refresh_token is injected via the provideVariables hook in httpyac.config.js
# (reads from gnome-keyring on every request click).
# Captures fresh access_token into gnome-keyring for all subsequent requests.
POST {{oidc_base}}/token
Content-Type: application/x-www-form-urlencoded

client_id={{client_id}}&grant_type=refresh_token&refresh_token={{refresh_token}}

{{
  if (response.parsedBody.access_token) {
    $global.access_token = response.parsedBody.access_token;
    if (response.parsedBody.refresh_token) {
      $global.refresh_token = response.parsedBody.refresh_token;
    }
    console.info("access_token refreshed and captured into $global.");
    const config = require('./httpyac.config.js');
    config.mergeAndSave(response.parsedBody);
    config.resetCache();
    console.info("Updated tokens in gnome-keyring (cache cleared for next read).");
  } else {
    console.warn("Token refresh failed:", response.parsedBody.error || response.statusCode);
  }
}}

### 4 — Get User Info (extracts user_id)
# Returns the SCP user profile. The `id` field (integer) is the user_id
# required for /users/{user_id}/... endpoints — NOT the customer number.
# user_id is auto-captured into $global and saved to gnome-keyring.
# Pre-request: loads access_token from keyring into $global if not already set
# (fallback for when $global doesn't persist between "Send Request" clicks).
{{
  if (!$global.access_token) {
    const config = require('./httpyac.config.js');
    const creds = config.loadFromKeyring();
    if (creds.access_token) {
      $global.access_token = creds.access_token;
      console.info("[pre-request] access_token loaded from keyring into $global.");
    } else {
      console.warn("[pre-request] No access_token in keyring — run Refresh Token first.");
    }
  }
}}
GET {{oidc_base}}/userinfo
Authorization: Bearer {{access_token}}

{{
  $global.user_id = response.parsedBody.id;
  console.info("user_id captured:", response.parsedBody.id);
  const config = require('./httpyac.config.js');
  config.mergeAndSave({ user_id: response.parsedBody.id });
  console.info("user_id saved to gnome-keyring.");
}}
