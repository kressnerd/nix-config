### Netcup SCP API — Server Management
# Power control, attributes, and configuration via PATCH.
# Only ONE attribute per PATCH request.

### Start Server (async — returns task UUID)
# state values: ON, OFF, SUSPENDED
PATCH {{base_url}}/servers/{{server_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "state": "ON"
}

### Stop Server (graceful shutdown, async)
PATCH {{base_url}}/servers/{{server_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "state": "OFF"
}

### Force Power Off Server
# stateOption for OFF: POWEROFF (force)
PATCH {{base_url}}/servers/{{server_id}}?stateOption=POWEROFF
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "state": "OFF"
}

### Restart Server (power cycle)
# stateOption for ON: POWERCYCLE or RESET
PATCH {{base_url}}/servers/{{server_id}}?stateOption=POWERCYCLE
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "state": "ON"
}

### Reset Server (hardware reset)
PATCH {{base_url}}/servers/{{server_id}}?stateOption=RESET
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "state": "ON"
}

### Suspend Server
PATCH {{base_url}}/servers/{{server_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "state": "SUSPENDED"
}

### Set Server Nickname
PATCH {{base_url}}/servers/{{server_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "nickname": "my-server"
}

### Set Server Hostname
PATCH {{base_url}}/servers/{{server_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "hostname": "server.example.com"
}

### Set Autostart
PATCH {{base_url}}/servers/{{server_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "autostart": true
}

### Set Boot Order
# Valid values: HDD, CDROM, NETWORK
PATCH {{base_url}}/servers/{{server_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "bootorder": ["HDD", "CDROM", "NETWORK"]
}

### Set OS Optimization
# Valid values: LINUX, WINDOWS, BSD, LINUX_LEGACY, UNKNOWN
PATCH {{base_url}}/servers/{{server_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "os_optimization": "LINUX"
}

### Set CPU Topology
PATCH {{base_url}}/servers/{{server_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "cpuTopology": {
    "socketCount": 1,
    "coresPerSocketCount": 2
  }
}

### Enable UEFI
PATCH {{base_url}}/servers/{{server_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "uefi": true
}

### Set Keyboard Layout
PATCH {{base_url}}/servers/{{server_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "keyboardLayout": "de"
}

### Set Root Password (async — returns task UUID)
PATCH {{base_url}}/servers/{{server_id}}
Authorization: Bearer {{access_token}}
Content-Type: application/merge-patch+json

{
  "rootPassword": "REPLACE_WITH_NEW_PASSWORD"
}
