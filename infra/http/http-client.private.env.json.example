    "server_name": "YOUR_SERVER_NAME",
    "interface_mac": "PASTE_MAC_FROM_INTERFACES_RESPONSE",
    "policy_id": "PASTE_POLICY_ID_FROM_POLICIES_RESPONSE",
    "task_uuid": "PASTE_TASK_UUID_FROM_ASYNC_RESPONSE"
  }
