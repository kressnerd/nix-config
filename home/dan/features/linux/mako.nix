_: {
  stylix.targets.mako.enable = true;

  services.mako = {
    enable = true;
    settings = {
      anchor = "top-right";
      border-radius = 8;
      border-size = 2;
      max-visible = 3;
      default-timeout = 5000;
      icons = false;
      margin = "8";
      padding = "12";
    };
  };
}
