 namespace waybar::modules::hyprland {
 
+namespace {
+
+// Hyprland parses every dispatch request as Lua (`hl.dispatch(<args>)`) under the
+// Lua config manager, so the text dispatchers ("dispatch workspace 3") fail to
+// parse and publish nothing. These build the documented Lua dispatcher forms:
+// https://wiki.hypr.land/configuring/core/dispatchers
+std::string focusWorkspace(const std::string& workspace, bool onCurrentMonitor) {
+  return "dispatch hl.dsp.focus({ workspace = \"" + workspace + "\"" +
+         (onCurrentMonitor ? ", on_current_monitor = true" : "") + " })";
+}
+
+std::string toggleSpecial(const std::string& name) {
+  if (name.empty()) {
+    return "dispatch hl.dsp.workspace.toggle_special()";
+  }
+  return "dispatch hl.dsp.workspace.toggle_special(\"" + name + "\")";
+}
+
+}  // namespace
