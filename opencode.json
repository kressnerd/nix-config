{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md"],
  "mcp": {
    "servers": {
      "nixos": {
        "type": "local",
        "command": ["nix", "run", ".#mcp-nixos", "--"]
      }
    }
  },
  "permissions": [
    {
      "action": "nixos_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sops *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "ssh-to-age *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "age -d *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "age --decrypt *",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "/run/secrets/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*sops/age/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*/var/lib/sops-nix/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat *sops/age/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat */var/lib/sops-nix/*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "cat /run/secrets/*",
      "effect": "deny"
    }
  ],
  "experimental": {
    "policies": [
      {
        "action": "permission",
        "resource": "shell:sops *",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:ssh-to-age *",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:age -d *",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "shell:age --decrypt *",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "read:/run/secrets/*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "read:*sops/age/*",
        "effect": "deny"
      },
      {
        "action": "permission",
        "resource": "read:*/var/lib/sops-nix/*",
        "effect": "deny"
      }
    ]
  },
  "permission": {
    "nixos_*": "allow"
  },
  "provider": {
    "aihub": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI-Hub",
      "options": {
        "baseURL": "https://adesso-ai-hub.3asabc.de/v1"
      },
      "models": {
        "qwen-3.6-35b-sovereign": {
          "name": "qwen-3.6-35b-sovereign"
        },
        "deepseek-v4-flash-sovereign": {
          "name": "deepseek-v4-flash-sovereign"
        },
        "gemma-4-26b-sovereign": {
          "name": "gemma-4-26b-sovereign"
        },
        "claude-haiku-4-5*": {
          "name": "claude-haiku-4-5*"
        },
        "claude-sonnet-5*": {
          "name": "claude-sonnet-5*"
        },
        "claude-opus-4-8*": {
          "name": "claude-opus-4-8*"
        }
      }
    }
  }
}
